# Real audits: set your Anthropic key. Without it, use SWC_LLM_PROVIDER=offline (heuristic demo only).
ANTHROPIC_API_KEY=
SWC_LLM_PROVIDER=anthropic
SWC_EXTRACTION_MODEL=claude-sonnet-5-5
SWC_EVALUATION_MODEL=claude-sonnet-5-5
SWC_CHEAP_MODEL=claude-haiku-5-5
SWC_EVALUATION_EFFORT=medium
# Comma-separated keys accepted in X-API-Key for service callers (e.g. SWP). UI users log in instead.
SWC_API_KEYS=
# Login (ADR 0009). Users: uv run python -m app.auth.seed you@x.com --name "You"
# false = no login, local dev only (still requires X-API-Key if SWC_API_KEYS is set).
SWC_AUTH_REQUIRED=true
SWC_SESSION_DAYS=7
# true when served over HTTPS
SWC_COOKIE_SECURE=false
# Database. Empty = SQLite file under SWC_DATA_DIR (local dev).
# Supabase (Prisma-style names, copy from Project Settings -> Database):
#   DATABASE_URL = transaction pooler (:6543) the app uses
#   DIRECT_URL   = session pooler / direct (:5432) that migrations use
# Plain postgresql:// URLs are fine; the app switches them to the psycopg driver and drops ?pgbouncer=true.
DATABASE_URL=
DIRECT_URL=
# SWC_DATABASE_URL overrides DATABASE_URL (tests set it to a temp SQLite file).
SWC_DATABASE_URL=
